public class ArrayEqualSplit {
    public static boolean canSplit(int[] arr) {
        int total = 0;
        for (int n : arr) total += n;
        int left = 0;
        for (int i = 0; i < arr.length - 1; i++) {
            left += arr[i];
            if (left == total - left) return true;
        }
        return false;
    }
}
